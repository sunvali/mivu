{
  "schemaVersion": 1,
  "name": "Mivu Precision Glass",
  "platform": "native iOS",
  "minimumAuditedOS": "26.0",
  "status": "Implemented native semantic palette; contrast and simulator captures recorded with the color update.",
  "colors": {
    "canvas": {
      "light": "#F5F8F8",
      "dark": "#111516"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1D2324"
    },
    "textPrimary": {
      "light": "#142023",
      "dark": "#F4F7F6"
    },
    "textSecondary": {
      "light": "#53646B",
      "dark": "#B7C4C8"
    },
    "accent": {
      "light": "#006D75",
      "dark": "#63D5CD",
      "highContrastLight": "#00545C",
      "highContrastDark": "#9CEDE6"
    },
    "onAccent": {
      "light": "#FFFFFF",
      "dark": "#092126"
    },
    "separator": {
      "light": "#D5DFE1",
      "dark": "#374346"
    },
    "error": {
      "light": "#B33143",
      "dark": "#FF9BA6",
      "highContrastLight": "#8C2030",
      "highContrastDark": "#FFC2C9"
    },
    "warning": {
      "light": "#925000",
      "dark": "#F4BC62",
      "highContrastLight": "#713D00",
      "highContrastDark": "#FFDBA0"
    },
    "protein": {
      "light": "#195DC2",
      "dark": "#91BCFF",
      "highContrastLight": "#124994",
      "highContrastDark": "#BAD5FF"
    },
    "carbs": {
      "light": "#925000",
      "dark": "#F4BC62",
      "highContrastLight": "#713D00",
      "highContrastDark": "#FFDBA0"
    },
    "fat": {
      "light": "#7740AD",
      "dark": "#CCA5F8",
      "highContrastLight": "#5E2E8E",
      "highContrastDark": "#E2CAFF"
    },
    "success": {
      "light": "#237448",
      "dark": "#80D5A4",
      "highContrastLight": "#175A34",
      "highContrastDark": "#B0EBC6"
    },
    "summarySurface": {
      "light": "#EAF5F3",
      "dark": "#142D2D",
      "highContrastLight": "#EAF5F3",
      "highContrastDark": "#142D2D"
    },
    "chartSurface": {
      "light": "#EDF3FC",
      "dark": "#19283A",
      "highContrastLight": "#EDF3FC",
      "highContrastDark": "#19283A"
    }
  },
  "semanticPolicy": "Use system semantic labels/backgrounds; custom accent is a dynamic asset with high-contrast variants. Reference hex values must be tested on actual composited material.",
  "spacingPt": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "layout": {
    "contentInsetPt": 20,
    "tapTargetMinPt": 44,
    "primaryActionMinHeightPt": 52,
    "ledgerRowMinHeightPt": 56,
    "twoLineRowMinHeightPt": 72,
    "thumbnailRadiusPt": 12,
    "groupRadiusPt": 16
  },
  "typography": {
    "family": "SF Pro system",
    "body": {
      "style": "body",
      "defaultPt": 17
    },
    "secondary": {
      "style": "subheadline",
      "defaultPt": 15
    },
    "metadata": {
      "style": "footnote",
      "defaultPt": 13
    },
    "rootTitle": {
      "style": "largeTitle",
      "weight": "bold"
    },
    "detailTitle": {
      "style": "headline",
      "weight": "semibold"
    },
    "metric": {
      "defaultPt": 48,
      "relativeTo": "largeTitle",
      "digits": "tabular",
      "scales": true
    },
    "accessibilityPolicy": "Stack rather than shrink; use system styles or ScaledMetric."
  },
  "materials": {
    "navigation": "native system Liquid Glass regular",
    "content": "opaque",
    "sheet": "system adaptive",
    "clearVariant": "not required",
    "reduceTransparency": "system native fallback",
    "customBlurRadius": null
  },
  "motion": {
    "navigation": "system",
    "inlineCrossfadeMs": 150,
    "reduceMotion": "crossfade or immediate",
    "numericCountUp": false
  },
  "navigation": {
    "tabs": [
      "Today",
      "Diary",
      "Progress",
      "Coach"
    ],
    "initial": "Today",
    "restoreLastTab": true,
    "settings": "profile button on every root",
    "detailTabBar": "hidden consistently",
    "minimizeTabBar": "disabled in v1"
  }
}
