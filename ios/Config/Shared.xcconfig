PRODUCT_NAME = Mivu
PRODUCT_DISPLAY_NAME = Mivu
PRODUCT_BUNDLE_IDENTIFIER = com.yakov103.mivu
MARKETING_VERSION = 1.10.0 // x-release-please-version
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
CODE_SIGN_ENTITLEMENTS = Config/Mivu.entitlements
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
// The reports worker in mivu-infra. Written https:/$()/host/path because // starts a comment. Empty means feedback goes by email.
MIVU_FEEDBACK_ENDPOINT = https:/$()/reports.mivuapp.com/feedback
