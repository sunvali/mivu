    "Teal: near your target. Orange: further off. Grey: logged, not judged yet. Empty: no log." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טורקיז: קרוב ליעד שלך. כתום: רחוק יותר. אפור: נרשם, עדיין לא נבדק. ריק: אין רישום."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde azulado: cerca de tu meta. Naranja: más lejos. Gris: registrado, aún sin evaluar. Vacío: sin registro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бирюзовый: близко к норме. Оранжевый: дальше. Серый: записано, оценки ещё нет. Пусто: нет записей."
          }
        }
      }
    },
