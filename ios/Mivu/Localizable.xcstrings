    "Runs on this iPhone with no account, but estimates are much less accurate. It only logs meals and changes amounts; connect ChatGPT for accurate estimates, questions and other edits." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פועל באייפון הזה בלי חשבון, אבל ההערכות מדויקות הרבה פחות. אפשר רק לרשום ארוחות ולשנות כמויות; להערכות מדויקות, לשאלות ולעריכות נוספות צריך לחבר את ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona en este iPhone sin cuenta, pero las estimaciones son mucho menos precisas. Solo registra comidas y cambia cantidades; conecta ChatGPT para tener estimaciones precisas, preguntas y otras ediciones."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на этом iPhone без аккаунта, но оценки намного менее точные. Только записывает еду и меняет количество; для точных оценок, вопросов и других правок подключи ChatGPT."
          }
        }
      }
    },
