          "stringUnit" : {
            "state" : "translated",
            "value" : "היעד הזה נמוך ממשקל תקין לגובה שלך, ולכן אי אפשר להגדיר אותו ב-Mivu. כדאי לבחור יעד גבוה יותר, או לפנות לרופא או לאיש מקצוע מוסמך בתחום התזונה."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa meta está por debajo de un peso saludable para tu estatura, así que Mivu no puede definirla. Elige una meta más alta o consulta a un médico o a un profesional de la nutrición."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта цель ниже здорового веса для твоего роста, поэтому Mivu не может её задать. Выбери цель повыше или обратись к врачу или дипломированному диетологу."
          }
        }
      }
