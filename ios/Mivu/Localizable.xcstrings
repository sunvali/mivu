    "Every capture gets a synthetic apple estimate. Photos and text are saved, but no food recognition runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every capture gets a synthetic apple estimate. Photos and text are saved, but no food recognition runs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל קליטה מקבלת הערכת תפוח סינתטית. תמונות וטקסט נשמרים, אבל לא מתבצע זיהוי מזון."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada captura recibe una estimación sintética de una manzana. Se guardan las fotos y el texto, pero no se reconocen alimentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая запись получает тестовую оценку яблока. Фото и текст сохраняются, но распознавание еды не выполняется."
          }
        }
      }
    },
    "Every food in this meal is resized by the same amount. Allowed: 10%% to 300%% of the current %@ kcal." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל המאכלים בארוחה הזו משתנים באותו יחס. מותר: 10%% עד 300%% מ-%@ קק״ל הנוכחיים."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los alimentos de esta comida se ajustan en la misma proporción. Permitido: del 10%% al 300%% de las %@ kcal actuales."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все продукты в этом приёме пищи изменятся пропорционально. Допустимо: от 10%% до 300%% текущих %@ ккал."
          }
        }
      }
    },
