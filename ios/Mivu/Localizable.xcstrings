    "Backup copies conflict. Your local diary and existing backup are preserved. Export a copy and resolve the folder copy in Files before retrying." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש התנגשות בין עותקי הגיבוי. היומן המקומי והגיבוי הקיים נשמרו. כדאי לייצא עותק ולפתור את ההתנגשות בתיקייה באפליקציית קבצים, ורק אז לנסות שוב."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de respaldo y tu diario no coinciden. Se conservan los dos. Exporta una copia y arregla la copia de la carpeta en Archivos antes de reintentar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии не совпадают. Локальный дневник и существующая копия сохранены. Экспортируй копию, устрани расхождение в папке через «Файлы» и повтори."
          }
        }
      }
    },
