    "Enter a positive number, or leave this blank." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להזין מספר חיובי, או להשאיר ריק."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa un número positivo o deja este campo en blanco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи положительное число или оставь поле пустым."
          }
        }
      }
    },
    "Enter a weight greater than 0 and no more than 1,000 %@." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להזין משקל גדול מ-0 ועד 1,000 %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa un peso mayor que 0 y no más de 1000 %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи вес больше 0 и не более 1 000 %@."
          }
        }
      }
    },
    "Enter an exercise name and 1–10,000 repetitions per set. Load can be blank for bodyweight, or 0–100,000 kg." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להזין שם תרגיל ו-1–10,000 חזרות בכל סט. אפשר להשאיר את העומס ריק למשקל גוף, או להזין 0–100,000 ק״ג."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa el nombre de un ejercicio y de 1 a 10 000 repeticiones por serie. La carga puede quedar en blanco si es con el peso corporal, o ser de 0 a 100 000 kg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи название упражнения и от 1 до 10 000 повторений в подходе. Нагрузку можно не указывать (для упражнений с собственным весом) или ввести от 0 до 100 000 кг."
          }
        }
      }
    },
    "Enter at least one nutrient. Leave unknown values blank; zero means a known zero. Saved as entered manually." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להזין לפחות רכיב תזונתי אחד. ערכים לא ידועים אפשר להשאיר ריקים; 0 אומר שהערך ידוע והוא אפס. נשמר כהזנה ידנית."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa al menos un nutriente. Deja en blanco los valores desconocidos; cero significa un cero conocido. Se guarda como ingreso manual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи хотя бы одно питательное вещество. Неизвестные значения оставь пустыми; ноль значит, что значение точно равно нулю. Сохраняется как введённое вручную."
          }
        }
      }
    },
