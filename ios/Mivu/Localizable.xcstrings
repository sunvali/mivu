    "This removes the meal and its attached photos from this diary." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעולה מסירה את הארוחה ואת התמונות המצורפות אליה מהיומן הזה."
