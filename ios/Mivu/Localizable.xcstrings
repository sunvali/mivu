    "Deletion removes this profile's meals, photos, weights and preferences from this iPhone. Other profiles are preserved." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion removes this profile's meals, photos, weights and preferences from this iPhone. Other profiles are preserved."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחיקה מסירה מהאייפון הזה את הארוחות, התמונות, המשקלים וההעדפות של הפרופיל הזה. פרופילים אחרים נשארים."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminarlo se quitan de este iPhone las comidas, fotos, registros de peso y preferencias de este perfil. Los demás perfiles se conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены приёмы пищи, фото, вес и настройки этого профиля на этом iPhone. Другие профили сохранятся."
          }
        }
      }
    },
    "Describe a meal, add a photo, or record a weigh-in or workout. You can review and correct every estimate. Coach gives estimates, not medical advice." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לתאר ארוחה, להוסיף תמונה או לרשום שקילה או אימון. אפשר לבדוק ולתקן כל הערכה. ההערכות של פיפ אינן ייעוץ רפואי."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe una comida, agrega una foto o registra un pesaje o un entrenamiento. Puedes revisar y corregir cada estimación. Coach da estimaciones, no consejo médico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиши еду, добавь фото или запиши взвешивание или тренировку. Каждую оценку можно проверить и исправить. Коуч даёт оценки, а не медицинские советы."
          }
        }
      }
