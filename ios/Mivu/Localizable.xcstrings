    "That target is below a healthy weight for your height, so Mivu can't set it. Choose a higher target, or talk to a doctor or registered dietitian." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היעד הזה נמוך ממשקל תקין לגובה שלך, ולכן אי אפשר להגדיר אותו ב-Mivu. כדאי לבחור יעד גבוה יותר, או לפנות לרופא או לאיש מקצוע מוסמך בתחום התזונה."
          }
        }
