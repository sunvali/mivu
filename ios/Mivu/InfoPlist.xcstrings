    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu uses the camera to attach meal photos to your private diary."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המצלמה משמשת להוספת תמונות של ארוחות ליומן הפרטי שלך."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu usa la cámara para adjuntar fotos de tus comidas a tu diario privado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu использует камеру, чтобы прикреплять фото еды к твоему личному дневнику."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu reads your workouts from Apple Health, such as those from Garmin Connect or Apple Watch, so their active calories can add to your daily food budget. They stay on this iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu קורא את האימונים שלך מ-Apple Health, למשל מ-Garmin Connect או מ-Apple Watch, כדי שהקלוריות הפעילות שלהם יתווספו לתקציב המזון היומי שלך. הם נשארים באייפון הזה."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu lee tus entrenamientos de la app Salud, como los de Garmin Connect o Apple Watch, para que sus calorías activas se sumen a tu presupuesto diario de alimentos. Se quedan en este iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu читает твои тренировки из приложения «Здоровье», например из Garmin Connect или Apple Watch, чтобы их активные калории добавлялись к дневной норме. Они остаются на этом iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu listens while you speak a meal so it can type it into Coach. Audio stays on this iPhone and is not saved."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיקרופון מאזין כשמספרים על ארוחה, כדי לכתוב אותה בשיחה עם פיפ. השמע נשאר באייפון הזה ולא נשמר."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu escucha mientras dictas una comida para escribirla en Coach. El audio se queda en este iPhone y no se guarda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu слушает, пока ты диктуешь еду, и превращает её в текст для коуча. Звук остаётся на этом iPhone и не сохраняется."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu turns your spoken meal into text on this iPhone so you can review it before sending."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדיבור הופך לטקסט באייפון הזה, כדי שאפשר יהיה לבדוק אותו לפני השליחה."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu convierte en texto, en este iPhone, la comida que dictas, para que la revises antes de enviarla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu превращает твою надиктованную еду в текст на этом iPhone, чтобы её можно было проверить перед отправкой."
          }
        }
      }
    },
    "Snap It" : {
      "comment" : "Home-screen quick-action title: opens camera to log a meal",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap It"
          }
        },
