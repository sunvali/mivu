    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu uses the camera to attach meal photos to your private diary."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המצלמה משמשת לצירוף תמונות של ארוחות ליומן הפרטי שלך."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu listens while you speak a meal so it can type it into Coach. Audio stays on this iPhone and is not saved."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיקרופון מאזין בזמן הקראת ארוחה, כדי להקליד אותה בשיחה עם פיפ. השמע נשאר באייפון הזה ואינו נשמר."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivu turns your spoken meal into text on this iPhone so you can review it before sending."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדיבור הופך לטקסט באייפון הזה, כדי שאפשר יהיה לבדוק אותו לפני השליחה."
          }
        }
      }
    },
    "Snap It" : {
      "comment" : "Home-screen quick-action title: opens camera to log a meal",
      "localizations" : {
