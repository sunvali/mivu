<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview only: iOS CaloriesProvider.sample. Never the initial layout, so it is never shown as real data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <ImageView
        android:id="@+id/widget_pip"
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/pip_wave" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/widget_figure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="1,360 of 2,000 calories eaten"
            android:importantForAccessibility="yes"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_eaten"
                style="@style/Widget.Mivu.Figure"
                android:layout_height="38dp"
                android:autoSizeMaxTextSize="32dp"
                android:text="1,360" />

            <TextView
                android:id="@+id/widget_goal"
                style="@style/Widget.Mivu.Goal"
                android:text="of 2,000 kcal" />
        </LinearLayout>

        <include layout="@layout/widget_calories_setup" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <ProgressBar
            android:id="@+id/widget_bar"
            style="@style/Widget.Mivu.Bar"
            android:layout_width="64dp"
            android:progress="680" />

        <TextView
            android:id="@+id/widget_set_target"
            style="@style/Widget.Mivu.SetTarget" />
    </LinearLayout>
</FrameLayout>
