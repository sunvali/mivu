<?xml version="1.0" encoding="utf-8"?>
<!-- iOS CaloriesWidgetView.medium: "Today", the figure, the goal bar, Snap It and Coach, and Pip beside them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <ImageView
        android:id="@+id/widget_pip"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/pip_wave" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/widget_figure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="1,360 of 2,000 calories eaten"
            android:importantForAccessibility="yes"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Today"
                android:textColor="@color/widget_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_eaten"
                style="@style/Widget.Mivu.Figure"
                android:layout_width="200dp"
                android:layout_height="44dp"
                android:autoSizeMaxTextSize="38dp"
                android:text="1,360" />

            <TextView
                android:id="@+id/widget_goal"
                style="@style/Widget.Mivu.Goal"
                android:text="of 2,000 kcal" />
        </LinearLayout>

        <include layout="@layout/widget_calories_setup" />

        <ProgressBar
            android:id="@+id/widget_bar"
            style="@style/Widget.Mivu.Bar"
            android:layout_width="200dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/widget_set_target"
            style="@style/Widget.Mivu.SetTarget"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- Stops short of Pip, as iOS's action row. -->
        <LinearLayout
            android:id="@+id/widget_actions"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_snap_it"
                style="@style/Widget.Mivu.Action"
                android:background="@drawable/widget_capsule_filled"
                android:drawableStart="@drawable/widget_ic_photo_camera"
                android:drawableTint="@color/widget_action_text"
                android:text="Snap It"
                android:textColor="@color/widget_action_text" />

            <TextView
                android:id="@+id/widget_coach"
                style="@style/Widget.Mivu.Action"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_capsule_tonal"
                android:drawableStart="@drawable/widget_ic_coach_filled"
                android:drawableTint="@color/widget_accent"
                android:text="Coach"
                android:textColor="@color/widget_accent" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
