<?xml version="1.0" encoding="utf-8"?>
<!-- iOS setUpText: shown instead of the figure until a diary is open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_setup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/widget_setup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Set up Mivu"
        android:textColor="@color/widget_text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/widget_setup_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pip will track your day here."
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />
</LinearLayout>
